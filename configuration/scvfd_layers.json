    {
        "name": "roads",
        "geometry_type": "linestring",
        "color": [
            20,
            20,
            20
        ],
        "add_labels": true,
        "label_color": [
            220,
            0,
            0
        ],
        "label_expression": "if(\"name\" IS NOT NULL AND length(trim(\"name\")) > 3, \"name\", NULL)",
        "qgis_width_scale": 4.0,
        "interaction": "interface",
        "vector_width": true,
        "editable_columns": [
            {
                "name": "name",
                "type": "string",
                "default": "Road"
            },
            {
                "name": "STREETTYPE",
                "type": "radio",
                "values": [
                    {
                        "STREETTYPE": "RD",
                        "vector_width": 15
                    },
                    {
                        "STREETTYPE": "ST",
                        "vector_width": 10
                    },
                    {
                        "STREETTYPE": "Other",
                        "vector_width": 8
                    }
                ],
                "default": {
                    "STREETTYPE": "ST",
                    "vector_width": 10
                }
            }
        ]
    },
    {
        "name": "roads_lrs",
        "geometry_type": "linestring",
        "color": [255, 140, 0],
        "interaction": "interface",
        "show_attributes": true,
        "editable_columns": [
            {"name": "m_start", "type": "string", "default": ""},
            {"name": "m_end", "type": "string", "default": ""}
        ],
        "paint": {
            "line-color": ["interpolate", ["linear"],
                ["min",
                    ["coalesce", ["get", "m_start"], 14000],
                    ["coalesce", ["get", "m_end"], 14000]
                ],
                0, "#00c800",
                5000, "#ffff00",
                9000, "#ffa500",
                13000, "#c80000",
                14000, "#888888"
            ],
            "line-width": 5,
            "line-opacity": 0.85
        }
    },
