{
    "mask_properties": {
        "name": "mask_properties",
        "asset_type": "eddy",
        "fetch_type": "mask_properties",
        "interaction": "backend",
        "data_type": "geojson"
    },
    "derived_hillshade": {
        "name": "hillshade",
        "asset_type": "eddy",
        "fetch_type": "derived_hillshade",
        "data_type": "tiff",
        "resample": 5000,
        "intensity": 0.5,
        "inpath_template": "/staging/dem.tiff",
        "outpath_template": "/staging/hillshade.tiff",
        "attribution": {
            "url": "https://www.scvfd.fireatlas.org",
            "description": "Hillshade derived from DEM",
            "license": "https://www.scvfd.fireatlas.org",
            "citation": "https://www.scvfd.fireatlas.org"
        }
    },
    "gdal_contours": {
        "name": "gdal_contours",
        "color": [
            2,
            219,
            9
        ],
        "interval": 50,
        "vector_width": 2,
        "asset_type": "eddy",
        "interaction": "backend",
        "fetch_type": "contours",
        "data_type": "geojson",
        "add_labels": false,
        "alterations": {
            "vector_width": {
                "default": 5
            },
            "label_attribute": "elevation",
            "canonicalize": [
                {
                    "to": "name",
                    "from": "elevation",
                    "default": ""
                }
            ]
        },
        "attribution": {
            "url": "https://www.scvfd.fireatlas.org",
            "description": "Merged road vector data",
            "license": "https://www.scvfd.fireatlas.org",
            "citation": "https://www.scvfd.fireatlas.org"
        }
    },
    "tiff_to_cog": {
        "asset_type": "eddy",
        "fetch_type": "tiff_to_cog",
        "data_type": "tiff"
    },
    "terrain_rgb_tiff": {
        "asset_type": "eddy",
        "fetch_type": "terrain_rgb_tiff",
        "data_type": "tiff"
    },
    "hillshade_tiles": {
        "asset_type": "eddy",
        "fetch_type": "hillshade_tiles",
        "data_type": "pmtiles",
        "min_zoom": 8,
        "max_zoom": 18,
        "attribution": {
            "description": "Hillshade raster tiles (PMTiles) for web map basemap"
        }
    },
    "terrain_rgb_tiles": {
        "asset_type": "eddy",
        "fetch_type": "terrain_rgb_tiles",
        "data_type": "pmtiles",
        "min_zoom": 8,
        "max_zoom": 14,
        "attribution": {
            "description": "Terrain-RGB tiles (PMTiles) for 3D terrain rendering"
        }
    },
    "h3_cells": {
        "type": "eddy",
        "fetch_type": "h3_cells",
        "in_layer": "roads",
        "out_layer": "roads_hexagons",
        "starting_resolution": 8,
        "algorithm": "max_num_cells",
        "max_cells": 10,
        "swap_coordinates": true,
        "attribution": {
            "url": "https://h3geo.org/",
            "description": "H3 hexagonal hierarchical geospatial indexing system",
            "license": "Apache 2.0",
            "citation": "Uber H3"
        }
    },
    "processing_sites_h3": {
        "type": "eddy",
        "fetch_type": "h3_cells",
        "in_layer": "photos",
        "out_layer": "processing_sites_index",
        "starting_resolution": 8,
        "algorithm": "max_num_cells",
        "max_cells": 10,
        "swap_coordinates": true,
        "attribution": {
            "url": "https://h3geo.org/",
            "description": "H3 hexagonal hierarchical geospatial indexing system",
            "license": "Apache 2.0",
            "citation": "Uber H3"
        }
    },
    "fuel_mass_landfire": {
        "type": "eddy",
        "fetch_type": "fuel_mass_landfire",
        "in_layer": "burns_index",
        "out_layer": "burns_index",
        "landfire_layer": "Landfire_LF2024/LF2024_EVC_CONUS",
        "attribution": {
            "url": "https://www.landfire.gov/",
            "description": "Fuel mass per H3 cell (tons/acre) derived from LANDFIRE EVC",
            "license": "Public Domain"
        }
    },
    "road_lrs": {
        "type": "eddy",
        "fetch_type": "road_lrs",
        "interaction": "backend",
        "in_layer": "roads",
        "out_layer": "roads_lrs",
        "h3_resolution": 12,
        "lrs_anchor_coordinates": null,
        "attribution": {
            "description": "Road LRS — cumulative network distance from anchor via H3 graph"
        }
    },
    "road_lrs_markers": {
        "type": "eddy",
        "fetch_type": "road_lrs_markers",
        "interaction": "backend",
        "in_layer": "roads_lrs",
        "out_layer": "lrs_markers",
        "marker_interval_m": 1000,
        "label_template": "{d_km:.0f} km",
        "marker_bbox": null,
        "road_names": null,
        "attribution": {
            "description": "Distance markers derived from road LRS"
        }
    },
    "ssurgo_enrich": {
        "type": "eddy",
        "fetch_type": "ssurgo_enrich",
        "interaction": "backend",
        "in_layer": "burn_sites",
        "attribution": {
            "url": "https://sdmdataaccess.nrcs.usda.gov/",
            "description": "USDA-NRCS SSURGO soil properties via Soil Data Access REST API",
            "license": "Public Domain"
        }
    },
    "merge_h3": {
        "type": "eddy",
        "fetch_type": "merge_h3",
        "interaction": "backend"
    },
    "biochar_simulation": {
        "type": "eddy",
        "fetch_type": "biochar_simulation",
        "in_layers": [
            "burns_index",
            "roads_index",
            "creeks_index",
            "processing_sites_index"
        ],
        "out_layer": "photos",
        "treatments_file": "configuration/treatments/default_treatments.json",
        "biomass_price": 0.001,
        "biochar_price": 0.01
    },
    "dst_match_simplified": {
        "asset_type": "eddy",
        "fetch_type": "dst_match_simplified",
        "in_layer": "ssurgo_polk_or",
        "biochar_layer": "biochar_properties_pnw",
        "goal": "raise_ph"
    }
}